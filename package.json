{
  "name": "stellar",
  "version": "0.1.0",
  "description": "Lean Apollo Federation / supergraph blueprint for BigCommerce headless storefronts",
  "main": "index.js",
  "scripts": {
    "test": "mocha",
    "start": "concurrently \"npm run server\" \"node ./server/subgraph-storefront/index\" \"node ./server/subgraph-customers/index\" \"node ./server/subgraph-catalog/index\" \"node ./server/subgraph-storeLogs/index\"",
    "server": "node ./server",
    "dev": "concurrently \"npm run server\" \"node ./server/subgraph-storefront/index\" \"node ./server/subgraph-customers/index\" \"node ./server/subgraph-catalog/index\" \"node ./server/subgraph-storeLogs/index\"",
    "prod": "node ./server",
    "compose-schema": "rover supergraph compose --config ./server/supergraph-config.yaml > ./server/supergraph.graphql",
    "storefront-subgraph-publish": "rover subgraph publish Storefront@dev --name storefront --schema ./server/subgraph-storefront/storefront.graphql --routing-url http://localhost:4001"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orphic-inc/stellar.git"
  },
  "keywords": [
    "bigcommerce",
    "apollo",
    "federation",
    "supergraph",
    "blueprint"
  ],
  "author": "Kyle O'Brien",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/orphic-inc/stellar/issues"
  },
  "homepage": "https://github.com/orphic-inc/stellar#readme",
  "dependencies": {
    "@apollo/gateway": "^2.0.5",
    "@apollo/subgraph": "^2.0.5",
    "apollo-datasource-rest": "^3.6.1",
    "apollo-server": "^3.9.0",
    "concurrently": "^7.3.0",
    "dotenv": "^16.0.1",
    "graphql": "^16.6.0",
    "apollo-datasource-graphql": "^1.3.2"
  },
  "devDependencies": {
    "mocha": "^10.0.0",
    "nodemon": "^2.0.19"
  }
}
