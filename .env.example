# Copy to .env and fill in from your BigCommerce store control panel
# (Settings > API > Store API accounts) to run the gateway against real data.

# Required by every subgraph's REST datasource (X-Auth-Token handshake)
BIGC_STORE_HASH=
BIGC_ACCESS_TOKEN=

# CORS origins the gateway accepts requests from
STORE_DOMAIN=
STORE_CANONICAL_URL=

# Optional -- override the gateway's listen port (defaults to 4000)
PORT=
